# OpenRouter Primary AI Engine
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_TIMEOUT=60
OPENROUTER_MAX_RETRIES=2

# Scoring Weights
ATS_WEIGHT=0.40
AGENT_WEIGHT=0.60

# Optional Server Port
PORT=3000

