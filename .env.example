VITE_FIREBASE_STORAGE_BUCKET=resume-parser-a82c1.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=691840703558
VITE_FIREBASE_APP_ID=1:691840703558:web:28556dac831874354fbe47
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)

